@model RentalManagementApp.ViewModels.Applications.ApplicationWizardViewModel
@using RentalManagementApp.ViewModels.Applications
@{
    ViewData["Title"] = "Rental Application";
}

<h2>Rental Application</h2>
<p class="text-muted">@Model.UnitLabel &middot; Status: @await Component.InvokeAsync("StatusBadge", Model.Status)</p>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<ul class="nav nav-pills mb-3">
    <li class="nav-item"><span class="nav-link @(Model.CurrentSection == WizardSection.ApplicantInfo ? "active" : "disabled")">1. Applicant Info</span></li>
    <li class="nav-item"><span class="nav-link @(Model.CurrentSection == WizardSection.ResidenceHistory ? "active" : "disabled")">2. Residence History</span></li>
    <li class="nav-item"><span class="nav-link @(Model.CurrentSection == WizardSection.Summary ? "active" : "disabled")">3. Summary</span></li>
</ul>

@if (Model.CurrentSection == WizardSection.Summary)
{
    @await Html.PartialAsync("_Summary", Model)
}
else
{
    <form method="post" asp-controller="Applications" asp-action="WizardStep">
        <input type="hidden" name="applicationId" value="@Model.ApplicationId" />
        <input type="hidden" name="currentSection" value="@Model.CurrentSection" />

        @if (Model.CurrentSection == WizardSection.ApplicantInfo)
        {
            @await Component.InvokeAsync("ApplicantInfoSection", Model)
        }
        else if (Model.CurrentSection == WizardSection.ResidenceHistory)
        {
            @await Component.InvokeAsync("ResidenceHistorySection", Model)
        }

        @if (!Model.IsReadOnly)
        {
            <div class="mt-4 d-flex gap-2">
                @if (Model.CurrentSection != WizardSection.ApplicantInfo)
                {
                    <button type="submit" name="action" value="back" formnovalidate class="btn btn-outline-secondary">Back</button>
                }
                <button type="submit" name="action" value="continue" class="btn btn-primary">Continue</button>
            </div>
        }
        else
        {
            <a class="btn btn-outline-secondary mt-4" asp-action="Details" asp-route-id="@Model.ApplicationId">Back to application</a>
        }
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('click', function (e) {
            var btn = e.target.closest('.open-residence-modal');
            if (!btn) return;
            var appId = btn.dataset.applicationId;
            var residenceId = btn.dataset.residenceId || '';
            fetch(`/Applications/ResidenceModal?applicationId=${appId}&id=${residenceId}`)
                .then(r => r.text())
                .then(html => {
                    document.getElementById('residenceModalBody').innerHTML = html;
                    new bootstrap.Modal(document.getElementById('residenceModal')).show();
                });
        });
    </script>
}

<div class="modal fade" id="residenceModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" id="residenceModalBody"></div>
    </div>
</div>
