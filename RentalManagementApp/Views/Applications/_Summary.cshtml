@model RentalManagementApp.ViewModels.Applications.ApplicationWizardViewModel

<h5 class="mb-3">Summary</h5>

<div class="card mb-3">
    <div class="card-header">Applicant Information</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.ApplicantInfo.FirstName @Model.ApplicantInfo.LastName</dd>
            <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.ApplicantInfo.Phone</dd>
            <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.ApplicantInfo.Email</dd>
            <dt class="col-sm-3">Current Address</dt><dd class="col-sm-9">@Model.ApplicantInfo.CurrentAddress</dd>
            <dt class="col-sm-3">Desired Lease Start</dt><dd class="col-sm-9">@Model.ApplicantInfo.DesiredLeaseStartDate.ToString("MM/dd/yyyy")</dd>
        </dl>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">Residence History</div>
    <div class="card-body">
        @if (Model.Residences.Any())
        {
            <table class="table table-sm mb-0">
                <thead><tr><th>Address</th><th>Landlord</th><th>Phone</th><th>Move In</th><th>Move Out</th></tr></thead>
                <tbody>
                @foreach (var r in Model.Residences)
                {
                    <tr>
                        <td>@r.Address</td><td>@r.LandlordName</td><td>@r.LandlordPhone</td>
                        <td>@r.MoveInDate.ToString("MM/dd/yyyy")</td><td>@(r.MoveOutDate?.ToString("MM/dd/yyyy") ?? "Present")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted mb-0">No prior residences added.</p>
        }
    </div>
</div>

@if (!Model.ApplicantInfoCompleted || !Model.ResidenceHistoryCompleted)
{
    <div class="alert alert-warning">Both sections must be completed before this application can be submitted.</div>
}

<form method="post" asp-controller="Applications" asp-action="WizardStep">
    @Html.AntiForgeryToken()
    <input type="hidden" name="applicationId" value="@Model.ApplicationId" />
    <input type="hidden" name="currentSection" value="@RentalManagementApp.ViewModels.Applications.Enums.WizardSection.Summary" />

    <div class="d-flex gap-2">
        <button type="submit" name="action" value="back" formnovalidate class="btn btn-outline-secondary">Back</button>

        @if (Model.CanSubmit)
        {
            <button type="submit" name="action" value="submit" class="btn btn-success">Submit Application</button>
        }
        else if (!Model.IsReadOnly)
        {
            <button type="button" class="btn btn-success" disabled>Submit Application</button>
        }
    </div>
</form>
