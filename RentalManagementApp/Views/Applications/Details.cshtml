@model RentalManagementApp.ViewModels.Applications.ApplicationDetailsViewModel
@{
    ViewData["Title"] = "Application Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Application #@Model.Id</h2>
    @await Component.InvokeAsync("StatusBadge", Model.Status)
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card mb-3">
    <div class="card-header">Overview</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Property / Unit</dt><dd class="col-sm-9">@Model.PropertyName - Unit @Model.UnitNumber</dd>
            <dt class="col-sm-3">Applicant</dt><dd class="col-sm-9">@Model.ApplicantName</dd>
            <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.ApplicantEmail</dd>
            <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.ApplicantPhone</dd>
            <dt class="col-sm-3">Current Address</dt><dd class="col-sm-9">@Model.CurrentAddress</dd>
            <dt class="col-sm-3">Desired Lease Start</dt><dd class="col-sm-9">@(Model.DesiredLeaseStartDate?.ToString("MM/dd/yyyy") ?? "Not specified")</dd>
            <dt class="col-sm-3">Desired Lease End</dt><dd class="col-sm-9">@(Model.DesiredLeaseStartDate?.AddMonths(12).AddDays(-1).ToString("MM/dd/yyyy") ?? "Not specified")</dd>
        </dl>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">Residence History</div>
    <div class="card-body">
        @if (Model.Residences.Any())
        {
            <table class="table table-sm mb-0">
                <thead><tr><th>Address</th><th>Landlord</th><th>Phone</th><th>Move In</th><th>Move Out</th></tr></thead>
                <tbody>
                @foreach (var r in Model.Residences)
                {
                    <tr>
                        <td>@r.Address</td><td>@r.LandlordName</td><td>@r.LandlordPhone</td>
                        <td>@r.MoveInDate.ToString("MM/dd/yyyy")</td><td>@(r.MoveOutDate?.ToString("MM/dd/yyyy") ?? "Present")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted mb-0">No residence history recorded.</p>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">Status History</div>
    <div class="card-body">
        <table class="table table-sm mb-0">
            <thead><tr><th>Status</th><th>Changed By</th><th>When</th><th>Comment</th></tr></thead>
            <tbody>
            @foreach (var h in Model.StatusHistory)
            {
                <tr>
                    <td>@h.Status</td>
                    <td>@h.ChangedByName</td>
                    <td>@h.ChangedAt.ToLocalTime().ToString("g")</td>
                    <td>@h.Comment</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex gap-2">
    @if (Model.CanApplicantEdit)
    {
        <a class="btn btn-primary" asp-controller="Applications" asp-action="Wizard" asp-route-id="@Model.Id">Continue Editing</a>
    }
    @if (Model.CanApplicantWithdraw)
    {
        <form method="post" asp-controller="Applications" asp-action="Withdraw" onsubmit="return confirm('Withdraw this application?');">
            <input type="hidden" name="id" value="@Model.Id" />
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger">Withdraw</button>
        </form>
    }
    @if (Model.CanManagerReview)
    {
        <button type="button" class="btn btn-success open-review-modal" data-id="@Model.Id">Review Application</button>
    }
</div>

<div class="modal fade" id="reviewModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content" id="reviewModalBody"></div></div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('click', function (e) {
            var btn = e.target.closest('.open-review-modal');
            if (!btn) return;
            fetch(`/Applications/ReviewModal?id=${btn.dataset.id}`).then(r => r.text()).then(html => {
                var modalBody = document.getElementById('reviewModalBody');
                modalBody.innerHTML = html;
                window.initializeUnobtrusiveValidation(modalBody);
                new bootstrap.Modal(document.getElementById('reviewModal')).show();
            });
        });
    </script>
}
